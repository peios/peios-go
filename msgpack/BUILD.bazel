load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "go_default_library",
    srcs = [
        "cursor.go",
        "msgpack.go",
        "writer.go",
    ],
    importpath = "github.com/peios/peios-go/msgpack",
    deps = [],
)

go_test(
    name = "tests",
    srcs = [
        "cursor_test.go",
        "msgpack_test.go",
    ],
    data = glob(
        ["testdata/**"],
        allow_empty = True,
    ),
    embed = [":go_default_library"],
    tags = [],
    deps = [],
)

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "rust/target/**",
        ],
    ),
)
