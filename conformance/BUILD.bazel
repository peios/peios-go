load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_go//go:def.bzl", "go_test")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//build:conformance.bzl", "conformance_test")

package(default_visibility = ["//visibility:public"])

go_test(
    name = "tests",
    srcs = [
        "conformance_test.go",
        "extended_test.go",
        "null_acl_test.go",
        "parity_test.go",
    ],
    data = glob(
        ["testdata/**"],
        allow_empty = True,
    ) + ["//security:testdata"],
    embed = [],
    tags = [],
    deps = [
        "//access:go_default_library",
        "//event:go_default_library",
        "//file:go_default_library",
        "//msgpack:go_default_library",
        "//security:go_default_library",
        "//socket:go_default_library",
        "//token:go_default_library",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "rust/target/**",
        ],
    ) + ["//conformance/vm-init:sources"],
)

cc_binary(
    name = "c-oracle",
    srcs = ["oracle.c"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    tags = ["manual"],
    deps = ["@peios_sdk//:peios"],
)

rust_binary(
    name = "rust-oracle",
    srcs = ["rust/src/main.rs"],
    edition = "2021",
    tags = ["manual"],
    deps = [
        "@oracle_crates//:libc",
        "@rust_sdk//:peios",
    ],
)

conformance_test(
    name = "differential-tests",
    binary = ":tests",
    c_oracle = ":c-oracle",
    libraries = ["@peios_sdk//:library"],
    rust_oracle = ":rust-oracle",
    tags = ["manual"],
)
