load("@rules_go//go:def.bzl", "go_test")

package(default_visibility = ["//visibility:public"])

go_test(
    name = "tests",
    srcs = [
        "extended_linux_amd64_test.go",
        "native_linux_amd64_test.go",
        "parity_linux_amd64_test.go",
        "registry_source_linux_amd64_test.go",
    ],
    data = glob(
        ["testdata/**"],
        allow_empty = True,
    ),
    embed = [],
    tags = [
        "manual",
        "peios-kernel",
    ],
    deps = [
        "//access:go_default_library",
        "//event:go_default_library",
        "//file:go_default_library",
        "//process:go_default_library",
        "//registry:go_default_library",
        "//registry/source:go_default_library",
        "//security:go_default_library",
        "//socket:go_default_library",
        "//token:go_default_library",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "rust/target/**",
        ],
    ),
)
