load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "go_default_library",
    srcs = [
        "actions_linux_amd64.go",
        "privileges.go",
        "sessions_linux_amd64.go",
        "spec.go",
        "thread_linux_amd64.go",
        "token_linux_amd64.go",
        "types.go",
        "views.go",
    ],
    importpath = "github.com/peios/peios-go/token",
    deps = [
        "//internal/native:go_default_library",
        "//internal/uapi:go_default_library",
        "//security:go_default_library",
    ],
)

go_test(
    name = "tests",
    srcs = [
        "guid_linux_amd64_test.go",
        "impersonate_linux_amd64_test.go",
        "sessions_linux_amd64_test.go",
        "spec_test.go",
    ],
    data = glob(
        ["testdata/**"],
        allow_empty = True,
    ),
    embed = [":go_default_library"],
    tags = [],
    deps = ["//security:go_default_library"],
)

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "rust/target/**",
        ],
    ),
)
