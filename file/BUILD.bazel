load("@rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "go_default_library",
    srcs = ["file_linux_amd64.go"],
    importpath = "github.com/peios/peios-go/file",
    deps = [
        "//internal/native:go_default_library",
        "//internal/uapi:go_default_library",
        "//security:go_default_library",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "rust/target/**",
        ],
    ),
)
